generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== HABIT TRACKER PROFESSIONAL V2 ====================

model HabitGroup {
  id        String  @id @default(cuid())
  name      String
  emoji     String  @default("📁")
  color     String  @default("#22c55e")
  order     Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  habits    Habit[]
}

model Habit {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("🎯")
  category    String   @default("General")
  priority    String   @default("Medium")
  difficulty  String   @default("Medium")
  // BUG-3 NOTE: target > 1 is stored but NOT supported by the UI. The habit
  // form clamps target to 1 (see habit-master.tsx handleSubmit), and the
  // daily-tracker only sends binary completion (value=1). Existing rows with
  // target > 1 are preserved on disk but will be reset to 1 the next time the
  // user edits that habit. Do not remove this column — it would break existing
  // rows. A future "multi-completion" feature could re-enable target > 1.
  target      Int      @default(1)
  // BUG-14 NOTE: targetType 'weekly' and 'monthly' are stored but NOT used by
  // the completion logic — every habit is treated as daily. The form disables
  // non-daily options to prevent users from picking an unsupported mode. Do
  // not remove this column (would break existing rows); a future
  // "weekly/monthly habit" feature could re-enable the other options.
  targetType  String   @default("daily")
  color       String   @default("#22c55e")
  reminder    String?
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      String   @default("active")
  notes       String?
  order       Int      @default(0)
  trackTime      Boolean  @default(false)
  targetTime     String?  // format "HH:mm", e.g. "05:30"
  trackLastDone  Boolean  @default(false)
  lastDoneInterval String? // format "Xd" or "Xw", e.g. "3d", "1w"
  groupId        String?
  // ── Vacation mode (Phase 1 — PHASE1-HABIT) ────────────────────────────
  // Pauses the habit without breaking its streak. While vacationMode=true:
  //   - The habit is excluded from the daily "completedCount/totalCount" so
  //     the daily summary doesn't penalize the user for not doing it.
  //   - The habit is excluded from the "Belum" (incomplete) filter.
  //   - The current day is treated as auto-completed for streak calculation
  //     so the streak continues through the vacation (computeStreak's
  //     `onVacation` option).
  //   - A "🏖️ Liburan" badge is shown on the habit card.
  // Auto-resume: GET /api/habits resets vacationMode to false once
  // vacationEnd < today (Jakarta midnight). vacationEnd null = indefinite
  // vacation (no auto-resume).
  vacationMode Boolean   @default(false)
  vacationEnd  DateTime?
  // ── Habit type (Phase 3 — PHASE3-HABIT) ──────────────────────────────
  // Controls how the habit is tracked + displayed:
  //   "normal" — default. Checking the box = success (green).
  //   "avoid"  — "don't do this" habit (e.g. no smoking, no sugar).
  //              Checking the box = RELAPSE (red). Streak = consecutive days
  //              WITHOUT a check. The habit card shows the relapse state in
  //              red instead of green, and the daily-tracker inverts the
  //              completion logic (unchecked = success).
  //   "amount" — daily goal with a numeric target (e.g. "drink 2L water").
  //              The target column stores the daily goal; the HabitLog.value
  //              column tracks progress toward it. The UI renders a progress
  //              bar instead of a binary check.
  habitType    String   @default("normal")
  createdAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        HabitLog[]
  group       HabitGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([status, order])
}

model HabitLog {
  id          String    @id @default(cuid())
  habitId     String
  date        DateTime
  completed   Boolean   @default(false)
  value       Int       @default(1)
  completedAt String?  // ISO string, exact time when completed (for time-tracked habits)
  createdAt   DateTime  @default(now())

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([completed])
  // PERF-API-1 FIX-TIER1: single-column index on `date` — used by
  // dashboard/statistics/analytics/ai-insights for date-range scans
  // (date gte/lte). Previously only @@unique([habitId, date]) existed,
  // which only helps habitId-prefix queries — date-only queries did a
  // full table scan.
  @@index([date])
}

model DailyLog {
  id        String   @id @default(cuid())
  date      DateTime @unique
  mood      Int      @default(3)
  energy    Int      @default(3)
  sleep     Float    @default(7)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  progress    Int      @default(0)
  priority    String   @default("Medium")
  status      String   @default("active")
  milestones  String   @default("[]")
  achievement String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== FINANCE TRACKER ====================

model FinanceCategory {
  id            String   @id @default(cuid())
  type          String   // "income" or "expense"
  name          String
  emoji         String   @default("📦")
  color         String   @default("#78716c")
  order         Int      @default(0)
  trackLastDone Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Prevent duplicate category names within the same type — previously
  // allowed two "Food" expense categories, which made `Budget.category`
  // (unique) ambiguous and broke the categories DELETE route's transaction
  // count.
  @@unique([type, name])
}

model FundSource {
  id        String   @id @default(cuid())
  name      String   @unique
  emoji     String   @default("💵")
  // Balance in whole rupiah (Int — never Float for money).
  balance   Int      @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // "income" or "expense"
  // Amount in whole rupiah (Int — never Float for money).
  amount      Int
  category    String
  description String?
  date        DateTime
  notes       String?
  source      String   @default("Kas")
  // Split transaction group ID. Null = standalone transaction.
  // Non-null = part of a split group (multiple transactions sharing
  // the same date/source/description but different category/amount).
  groupId     String?
  // PHASE4-POLISH: tags — JSON-encoded array of strings (e.g. '["urgent","work"]').
  // Stored as a String column because SQLite has no native array type. Empty
  // array is stored as "[]" (the schema default) so existing rows + future
  // rows always have a parseable value. The API + UI parse/serialize on the
  // fly; no ORM-level JSON type is needed.
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type, date])
  @@index([source, date])
  @@index([category])
  @@index([groupId])
}

model Budget {
  id          String   @id @default(cuid())
  category    String   @unique
  // Budget amount in whole rupiah (Int — never Float for money).
  amount      Int
  period      String   @default("monthly") // "weekly" or "monthly"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Weekly budget tracker — 4 weeks per month (1-7, 8-14, 15-21, 22-end).
// User sets a max spending target per week. Rollover carries remaining
// budget to the next week. Auto-resets each month.
model WeeklyBudget {
  id        String   @id @default(cuid())
  month     String   // "yyyy-MM" format, e.g. "2026-07"
  week      Int      // 1, 2, 3, or 4
  target    Int      // max spending target for this week (whole rupiah)
  rollover  Boolean  @default(true) // whether remaining budget carries to next week
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, week])
  @@index([month])
}

// Budget history per month — auto-saved at end of each month or on demand.
// Tracks: how much was budgeted, how much was spent, and the rollover.
model BudgetSnapshot {
  id           String   @id @default(cuid())
  category     String
  month        String   // "yyyy-MM" format
  budgetAmount Int      // original budget for that month
  spentAmount  Int      // actual spending for that month
  rolloverIn   Int      @default(0) // carried from previous month
  rolloverOut  Int      @default(0) // carried to next month (if positive)
  effectiveBudget Int  @default(0) // budgetAmount + rolloverIn
  percentage   Int      @default(0) // spentAmount / effectiveBudget * 100
  status       String   @default("active") // "active", "closed"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([category, month])
  @@index([month])
  @@index([category])
}

// Savings goal / piggy bank — a named target (e.g. "Liburan" Rp 10.000.000)
// with a tracked currentAmount. Optional sourceName links the goal to a
// FundSource for "where do I save this?" reference (manual sync, not
// auto-deducted). Auto-marks isCompleted when currentAmount >= targetAmount.
model SavingsGoal {
  id            String    @id @default(cuid())
  name          String
  emoji         String    @default("🎯")
  targetAmount  Int
  currentAmount Int       @default(0)
  // Optional FundSource.name reference — informational only (we do NOT
  // auto-deduct from the source when adding to the goal). Manual sync.
  sourceName    String?
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AppSettings {
  id               String   @id @default(cuid())
  userName         String   @default("User")
  theme            String   @default("light")
  primaryColor     String   @default("#22c55e")
  secondaryColor   String   @default("#f0fdf4")
  weekStart        String   @default("monday")
  language         String   @default("en")
  targetCompletion Int      @default(80)
  // Daily budget target in whole rupiah. 0 = not set (ring hidden in UI).
  // User-set via the progress ring tap → dialog in Daily Recap. Applies to
  // all days (single value, no per-day override).
  dailyBudgetTarget Int     @default(0)
  // JSON-encoded array of expense category NAMES selected as the basis for
  // the Daily Recap month-end projection. "[]" (empty) = use ALL expense
  // categories (default behaviour). Non-empty = only those categories are
  // counted when computing monthEndProjection / topProjectedCategory /
  // projectionConfidence. Stored as a JSON string because SQLite does not
  // support array columns. Category names (not IDs) are stored because
  // Transaction.category is a name string — this keeps the filter a simple
  // string match with no join needed. If a category is renamed or deleted,
  // its stale name simply won't match any transaction and is ignored.
  projectionCategoryIds String @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HabitOption {
  id        String   @id @default(cuid())
  type      String   // 'category', 'priority', 'difficulty'
  name      String
  color     String   @default("gray")  // key into LABEL_COLORS palette
  xp        Int      @default(0)       // only used for 'difficulty' type
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([type])
}

// ==================== PHASE 2: RECURRING + RULE ENGINE ====================

// Recurring transaction template — auto-creates a Transaction on a schedule.
// (Concept from Actual Budget + Firefly III.)
//
// Frequency determines how the next run is computed:
//   daily   → every `interval` days from lastRunAt (or startDate if never run)
//   weekly  → every `interval` weeks on `dayOfWeek` (0=Sunday..6=Saturday)
//   monthly → on `dayOfMonth` (1-31) every `interval` months. If dayOfMonth
//             exceeds the month's length (e.g. 31 in February), the last day
//             of that month is used.
//
// `lastRunAt` is updated atomically after each transaction is created so
// the process endpoint is idempotent within a single due-window.
model RecurringTransaction {
  id          String   @id @default(cuid())
  type        String   // 'income' or 'expense'
  amount      Int
  category    String
  description String?
  source      String   @default("Kas")
  frequency   String   // 'daily', 'weekly', 'monthly'
  dayOfMonth  Int?     // for monthly (1-31)
  dayOfWeek   Int?     // for weekly (0-6, 0=Sunday)
  interval    Int      @default(1) // every N days/weeks/months
  startDate   DateTime @default(now())
  endDate     DateTime?
  lastRunAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([frequency])
}

// Auto-categorization rule — applied to new transactions BEFORE insert.
// (Concept from Firefly III.)
//
// When a transaction is POSTed, the rule engine walks active rules sorted by
// priority (asc) then createdAt (asc). The FIRST matching rule's action wins
// (first-match-wins semantics) — overrides category/source on the incoming
// transaction.
//
// conditionField/op/value examples:
//   description contains "indomaret"  → category = "Makanan & Minuman"
//   source      equals    "GoPay"     → source   = "GoPay" (no-op)
//   amount      gt        "100000"    → category = "Tagihan & Utilitas"
model TransactionRule {
  id              String   @id @default(cuid())
  name            String
  isActive        Boolean  @default(true)
  priority        Int      @default(0) // lower = evaluated first
  conditionField  String   // 'description', 'source', 'amount'
  conditionOp     String   // 'contains', 'equals', 'startsWith', 'gt', 'lt'
  conditionValue  String
  actionField     String   // 'category', 'source'
  actionValue     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, priority])
}
