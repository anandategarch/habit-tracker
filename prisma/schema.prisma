// Rutina — habit + personal finance tracker (single-user)
// Konvensi tanggal (hasil bug-hunt ronde sebelumnya):
//  * HabitLog.date / DailyLog.date  -> UTC midnight (00:00:00Z) dari hari Jakarta
//  * Transaction.date               -> tengah hari (12:00Z) agar aman TZ browser/server
//  * completedAt                    -> waktu Jakarta nyata (ISO dengan offset +07:00)
//  * RecurringTransaction.startDate -> dipatok tengah malam Jakarta (+07:00)

generator client {
  provider        = "prisma-client-js"
  // Driver adapter libsql: satu jalur untuk SQLite lokal (file:) DAN Turso (libsql://).
  // Wajib untuk deploy Vercel — file SQLite tidak bisa dipakai di lambda (FS read-only).
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id              String   @id @default("singleton")
  userName        String   @default("User")
  theme           String   @default("system") // light | dark | system
  themeColor      String   @default("teal")
  weekStart       Int      @default(1) // 0 = Minggu, 1 = Senin
  language        String   @default("id") // kolom tersimpan; UI selalu Indonesia
  targetCompletion Int     @default(80)
  appLockHash     String?
  updatedAt       DateTime @updatedAt
}

model Habit {
  id           String      @id @default(cuid())
  name         String
  emoji        String      @default("✅")
  category     String      @default("General")
  priority     String      @default("Medium") // Low | Medium | High
  difficulty   String      @default("Medium") // Easy | Medium | Hard — bobot XP
  habitType    String      @default("normal") // normal | amount | avoid
  target       Int         @default(1) // amount: target harian (mis. 8 gelas)
  unit         String?
  targetType   String? // daily | weekly | monthly (kolom disiapkan)
  // Task 36 — Target Lulus (garis finis habit): jumlah hari selesai yang
  // dituju sebelum habit "diwisuda". null = tanpa target (habit selamanya).
  targetDays   Int?
  // Task 36 — tanggal kelulusan (ISO). null = belum lulus. Habit lulus
  // keluar dari rotasi harian & tampil berstatus 🎓 Lulus di Habit Master.
  graduatedAt  DateTime?
  // Task 37 — Jadwal Tampil: habit tidak harus muncul setiap hari.
  // JSON {kind:'weekly',days:[1,3]} (0=Minggu..6=Sabtu) atau
  // {kind:'monthly',dates:[1,15]} (tanggal dalam bulan). null = setiap hari
  // (default; kompatibel mundur dengan semua habit lama).
  scheduleJson String?
  reminder     String? // string bebas "misal 08:00"
  notes        String?
  trackTime    Boolean     @default(false)
  groupId      String?
  group        HabitGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // CONNECTED-APP (Task 49) — Habit ↔ Goal: habit boleh mendukung satu
  // tujuan (nullable). Additive; habit lama tidak terpengaruh. Saat tujuan
  // dihapus, API membersihkan link (goalId → null) supaya tidak menggantung.
  goalId       String?
  goal         Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  isArchived   Boolean     @default(false)
  vacationMode Boolean     @default(false)
  vacationUntil DateTime?
  // Task 60-c (audit 59-b2 HIGH): riwayat interval liburan — JSON array
  // [{"s":"yyyy-MM-dd","u":"yyyy-MM-dd"|null}] (hingga 50). Sebelumnya hanya
  // vacationMode/vacationUntil yang hidup SAAT mode aktif; setelah kadaluarsa
  // hari libur menjadi miss → streak putus ke 0 (janji UI "streak menyala
  // kembali" tidak ditepati). Kolom ini membuat hari libur NETRAL permanen
  // di hitungan streak (frontend tracker, dashboard, ai-insights). Aditif &
  // nullable — habit lama (null) tidak terpengaruh; di-produksi via DDL
  // runtime ensureHabitGraduation() (pola Task 36/37/49).
  vacationIntervals String?
  startDate    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  habitLogs    HabitLog[]
}

model HabitLog {
  id          String    @id @default(cuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        DateTime // UTC midnight dari hari Jakarta
  completed   Boolean   @default(true)
  value       Int       @default(1) // jumlah unit (habit amount)
  completedAt DateTime? // waktu Jakarta nyata
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([habitId, date])
  @@index([date])
}

model DailyLog {
  id        String   @id @default(cuid())
  date      DateTime @unique // UTC midnight dari hari Jakarta
  mood      Float    @default(3) // 1..5
  energy    Float    @default(3) // 1..5
  sleep     Float    @default(7) // jam
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HabitOption {
  id        String  @id @default(cuid())
  type      String // category | priority | difficulty | unit
  label     String
  color     String?
  sortOrder Int     @default(0)

  @@unique([type, label])
}

model HabitGroup {
  id        String  @id @default(cuid())
  name      String
  color     String  @default("#14b8a6")
  sortOrder Int     @default(0)
  habits    Habit[]
}

model Transaction {
  id             String       @id @default(cuid())
  type           String // income | expense | transfer
  amount         Float
  category       String
  sourceId       String?
  source         FundSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  description    String
  notes          String?
  tags           String       @default("") // dipisah koma
  date           DateTime // 12:00Z dari hari Jakarta (TZ-safe)
  // Task 60-f (audit 59-b3 MED): penanda kelompok hasil "Split" — badge
  // "Split" di daftar transaksi dulunya dead-code (tidak pernah ada
  // kolom/pengirimnya). Diiisi oleh POST /api/finance/transactions/split
  // (satu id dibagi ke seluruh baris hasil pecahan). Nullable; transaksi
  // biasa = null. Produksi via DDL runtime ensureTransactionGroupId().
  groupId        String?
  transferPairId String?    @unique
  transferPair   Transaction? @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPaired Transaction? @relation("TransferPair")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date])
  @@index([category])
}

model FundSource {
  id             String        @id @default(cuid())
  name           String
  emoji          String        @default("💰")
  type           String        @default("bank") // cash | bank | ewallet
  initialBalance Float         @default(0)
  isArchived     Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
}

model FinanceCategory {
  id        String @id @default(cuid())
  name      String @unique
  emoji     String @default("💸")
  color     String @default("#14b8a6")
  type      String @default("expense") // expense | income
}

model WeeklyBudget {
  id        String   @id @default(cuid())
  category  String
  month     String // yyyy-MM (Jakarta)
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, month])
}

model BudgetSnapshot {
  id           String   @id @default(cuid())
  category     String
  month        String
  week         Int
  weeklyAmount Float
  spent        Float
  createdAt    DateTime @default(now())
}

model SavingsGoal {
  id            String    @id @default(cuid())
  name          String
  emoji         String    @default("🎯")
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RecurringTransaction {
  id        String    @id @default(cuid())
  name      String
  amount    Float
  type      String // income | expense
  category  String
  sourceId  String?
  frequency String // daily | weekly | monthly
  startDate DateTime // tengah malam Jakarta (+07:00)
  endDate   DateTime?
  lastRun   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TransactionRule {
  id        String   @id @default(cuid())
  keyword   String
  category  String
  sourceId  String?
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  priority    String   @default("Medium") // Low | Medium | High
  status      String   @default("active") // active | completed | cancelled
  deadline    String? // yyyy-MM-dd (dibaca komponen YMD, bukan UTC midnight)
  milestones  String   @default("[]") // JSON [{ text, done }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // CONNECTED-APP (Task 49) — habit yang mendukung tujuan ini.
  habits      Habit[]
}

// ── Meja Kerja (Task 17-a) ─────────────────────────────────────────────────
// Catatan kerjaan harian: rutinitas berulang + tugas lepas + catatan kilat.
// Konvensi tanggal sama dengan HabitLog/DailyLog: dayKey = 'yyyy-MM-dd' Jakarta
// (disimpan sebagai STRING, bukan DateTime, supaya perbandingan leksikografis
// sederhana dan aman lintas TZ).

model WorkRoutine {
  id        String          @id @default(cuid())
  title     String
  timeOfDay String          @default("pagi") // pagi | siang | sore
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  logs      WorkRoutineLog[]
}

model WorkRoutineLog {
  id        String      @id @default(cuid())
  routineId String
  routine   WorkRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dayKey    String // yyyy-MM-dd (Asia/Jakarta)
  done      Boolean     @default(false)
  doneAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([routineId, dayKey])
}

model WorkTask {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  status      String    @default("todo") // todo | jalan | nunggu | selesai
  dayKey      String? // tanggal target yyyy-MM-dd; null = kapan saja
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkNote {
  id        String   @id @default(cuid())
  content   String
  tag       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fase 2 (Task 19): penanda hari untuk Meja Kerja — terutama Mode Libur
// (rutinitas diliburkan untuk hari itu tanpa memutus aktif/i-nya rutinitas).
model WorkDayFlag {
  id        String   @id @default(cuid())
  dayKey    String   @unique // yyyy-MM-dd (Jakarta)
  holiday   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
