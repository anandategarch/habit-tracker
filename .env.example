#
# Rutina — Environment Variables
#
# Copy ke `.env` (local). JANGAN pernah commit `.env` / `.env.local`.
# Untuk production (Vercel), set nilai ini di dashboard Vercel.

# ---- Database (WAJIB) ----
# Satu jalur kode untuk dua lingkungan (libsql driver adapter):
#  * Lokal  : file:./db/dev.db          (SQLite via libsql)
#  * Turso  : libsql://… (dari `turso db show <nama> --url`) + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./db/dev.db

# Alternatif satu-var (token tertanam di URL — didukung juga):
# DATABASE_URL=libsql://nama-db-user.turso.io?authToken=eyJ…

# Auth token Turso — WAJIB bila DATABASE_URL adalah libsql:// (production).
# Dibuat dengan: turso db tokens create <nama-db>
# DATABASE_AUTH_TOKEN=eyJ…

# ---- Sinkronisasi schema ke Turso (scripts/turso-push.ts) ----
# Hanya dipakai `bun run turso:push` dari mesin lokal — bukan oleh app.
# TURSO_DATABASE_URL=libsql://…
# TURSO_AUTH_TOKEN=eyJ…

# ---- Z.AI SDK (opsional) ----
# Dipakai endpoint AI (/api/ai-insights). Di sandbox Z.ai kredensial terbaca
# otomatis dari environment; untuk self-host, set sesuai dokumentasi SDK.
# ZAI_API_KEY=

# ---- NextAuth (opsional — untuk multi-user di masa depan) ----
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# CATATAN KEAMANAN (baca sebelum deploy publik):
# App ini tidak punya auth user dan tidak punya middleware API key.
# Endpoint /api/reset-all bersifat destruktif. Lindungi deployment publik
# dengan Vercel Password Protection / Basic Auth di edge — lihat README.md.
