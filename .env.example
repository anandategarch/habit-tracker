# ====================================
# Habit Tracker — Environment Variables
# ====================================
# Copy this file to `.env.local` (NEVER commit `.env` or `.env.local`).
# For production (Vercel), set these in the Vercel dashboard.

# ---- Database ----
# Local development (default — file-based SQLite)
DATABASE_URL="file:./db/dev.db"

# Turso Cloud (production). Get these from https://turso.tech
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ---- API Authentication (REQUIRED for production deployments) ----
# BUG-1/BUG-9 fix: when APP_API_KEY is set, every /api/* request must
# include header `x-api-key: <value>` or query string `?apiKey=<value>`.
# When NOT set, the API is open (no auth) — suitable for local dev only.
#
# ⚠️  WARNING: deploying to production WITHOUT APP_API_KEY set means
# anyone with the URL can access/modify/delete ALL your data, including
# the destructive DELETE /api/reset-all endpoint.
#
# For production:
#   1. Generate a key: openssl rand -hex 32
#   2. Set APP_API_KEY in Vercel env vars
#   3. Set NEXT_PUBLIC_APP_API_KEY to the SAME value (client-side fetch
#      needs it to authenticate API calls)
#
# APP_API_KEY=""
# NEXT_PUBLIC_APP_API_KEY=""

# ---- Z.AI SDK (used by /api/learning/article) ----
# The z-ai-web-dev-sdk reads its credentials from the environment automatically
# when running inside the Z.ai sandbox. For self-hosted deployments you may
# need to provide credentials per the SDK documentation.
# ZAI_API_KEY="..."

# ---- NextAuth (optional — for future multi-user auth) ----
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"
